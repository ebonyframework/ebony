// Le SQL que « ebony make » écrit dans le code généré : la création de la table (migration) et les cinq requêtes du repository. Fonctions pures, testées dans tests/unitaires/commandes/make/.
// Tout nom (table, colonne) est écrit entre guillemets doubles : c'est ce qui permet une colonne « Date de naissance », « order » ou « user » (SQLite et PostgreSQL les acceptent). Les valeurs ne sont JAMAIS
// écrites dans le texte : elles passent par des paramètres {p_…} (voir cEbChampTable.NomSql), qui neutralisent l'injection SQL.
// Les noms ont déjà été vérifiés par EbVerifieNomSql : aucun guillemet, accent grave, crochet, pour cent ni accolade, donc le texte tient dans une chaîne OWL entre accents graves.
// Dialectes : sqlite et postgresql (les valeurs de --base). HFSQL : les requêtes du repository sont les mêmes et non vérifiées ; la création de table n'est pas écrite (voir cEbGenerationMake).
EbSqlMake est une CollectionDeProcédures

	// Un nom entre guillemets doubles : clients → "clients".
	PROCEDURE EbSqlNom(sNom est une chaîne) : chaîne
		RENVOYER Caract(34) + sNom + Caract(34)
	FIN

	// Une table, avec son schéma éventuel, entre guillemets : crm.clients → "crm"."clients".
	PROCEDURE EbSqlTable(sTable est une chaîne) : chaîne
		sRes est une chaîne = ""
		POUR TOUT sPartie DE ChaîneDécoupe(sTable, ".")
			SI sRes <> "" ALORS
				sRes += "."
			FIN
			sRes += EbSqlNom(sPartie)
		FIN
		RENVOYER sRes
	FIN

	// Le paramètre SQL d'un champ : {p_nom}.
	PROCEDURE EbSqlParametre(oChamp est un cEbChampTable) : chaîne
		RENVOYER "{" + oChamp.NomSql() + "}"
	FIN

	// Vrai si la base donne elle-même la clé : une clé primaire entière (auto-incrément). Une clé texte est fournie par l'appelant.
	PROCEDURE EbCleGeneree(oChamp est un cEbChampTable) : booléen
		RENVOYER oChamp.Cle() ET oChamp.TypeChamp() = "entier"
	FIN

	// Le type SQL d'une colonne ordinaire. Les dates sont du texte ISO dans les deux bases ; un booléen est 0 ou 1 dans SQLite.
	PROCEDURE EbSqlTypeColonne(sType est une chaîne, sBase est une chaîne) : chaîne
		SELON sType
			CAS "entier"
			RENVOYER "INTEGER"
			CAS "reel"
			SI sBase = "postgresql" ALORS
				RENVOYER "DOUBLE PRECISION"
			FIN
			RENVOYER "REAL"
			CAS "booleen"
			SI sBase = "postgresql" ALORS
				RENVOYER "BOOLEAN"
			FIN
			RENVOYER "INTEGER"
			AUTRE CAS
			RENVOYER "TEXT"
		FIN
	FIN

	// Le schéma d'un nom de table « schema.table » (crm.clients → crm), ou « » s'il n'y en a pas.
	PROCEDURE EbSchemaTable(sTable est une chaîne) : chaîne
		nPoint est un entier = Position(sTable, ".")
		SI nPoint = 0 ALORS
			RENVOYER ""
		FIN
		RENVOYER Gauche(sTable, nPoint - 1)
	FIN

	// La table visée par une clé étrangère. Constaté avec OWL 1.6.0 et SQLite 3.46 : « REFERENCES "crm"."Clients" (...) » est une erreur de syntaxe, « REFERENCES "Clients" (...) » passe ;
	// on garde donc seulement le nom de la table pour SQLite, et le nom complet pour PostgreSQL.
	PROCEDURE EbTableReferencee(sTable est une chaîne, sBase est une chaîne) : chaîne
		nPoint est un entier = Position(sTable, ".")
		SI sBase = "sqlite" ET nPoint > 0 ALORS
			RENVOYER Milieu(sTable, nPoint + 1)
		FIN
		RENVOYER sTable
	FIN

	// La définition d'une colonne dans CREATE TABLE : "nom" TEXT NOT NULL, "id" INTEGER PRIMARY KEY AUTOINCREMENT, "client_id" INTEGER NOT NULL REFERENCES "clients" ("id").
	PROCEDURE EbSqlColonne(oChamp est un cEbChampTable, sBase est une chaîne) : chaîne
		sDef est une chaîne = EbSqlNom(oChamp.NomColonne()) + " " + EbSqlTypeColonne(oChamp.TypeChamp(), sBase)
		SI oChamp.Cle() ALORS
			SI EbCleGeneree(oChamp) ALORS
				SI sBase = "postgresql" ALORS
					sDef += " GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY"
				SINON
					sDef += " PRIMARY KEY AUTOINCREMENT"
				FIN
			SINON
				sDef += " NOT NULL PRIMARY KEY"
			FIN
		SINON
			SI PAS oChamp.Nullable() ALORS
				sDef += " NOT NULL"
			FIN
		FIN
		SI oChamp.ARef() ALORS
			sDef += " REFERENCES " + EbSqlTable(EbTableReferencee(oChamp.RefTable(), sBase)) + " (" + EbSqlNom(oChamp.RefColonne()) + ")"
		FIN
		RENVOYER sDef
	FIN

	// CREATE TABLE sur plusieurs lignes, sans indentation : l'en-tête, une ligne par colonne (virgule finale sauf la dernière), la parenthèse fermante. L'appelant indente.
	PROCEDURE EbSqlCreeTable(oDemande est un cEbDemandeMake, sBase est une chaîne) : tableau de chaînes
		tabLignes est un tableau de chaînes
		TableauAjoute(tabLignes, "CREATE TABLE " + EbSqlTable(oDemande.NomTable()) + " (")
		nNb est un entier = oDemande.Champs()..Occurrence
		POUR i = 1 À nNb
			sLigne est une chaîne = EbSqlColonne(oDemande.Champs()[i], sBase)
			SI i < nNb ALORS
				sLigne += ","
			FIN
			TableauAjoute(tabLignes, sLigne)
		FIN
		TableauAjoute(tabLignes, ")")
		RENVOYER tabLignes
	FIN

	// La même instruction sur une seule ligne, pour un test ou une chaîne OWL courte.
	PROCEDURE EbSqlCreeTableLigne(oDemande est un cEbDemandeMake, sBase est une chaîne) : chaîne
		sRes est une chaîne = ""
		POUR TOUT sLigne DE EbSqlCreeTable(oDemande, sBase)
			SI sRes <> "" ALORS
				sRes += " "
			FIN
			sRes += sLigne
		FIN
		RENVOYER sRes
	FIN

	PROCEDURE EbSqlSupprimeTable(oDemande est un cEbDemandeMake) : chaîne
		RENVOYER "DROP TABLE " + EbSqlTable(oDemande.NomTable())
	FIN

	// La clé primaire de la demande.
	PROCEDURE EbSqlCle(oDemande est un cEbDemandeMake) : cEbChampTable
		RENVOYER EbChampCle(oDemande.Champs())
	FIN

	// Toutes les colonnes entre guillemets, dans l'ordre des champs : "id", "nom", "email".
	PROCEDURE EbSqlColonnes(oDemande est un cEbDemandeMake) : chaîne
		sRes est une chaîne = ""
		POUR TOUT oChamp DE oDemande.Champs()
			SI sRes <> "" ALORS
				sRes += ", "
			FIN
			sRes += EbSqlNom(oChamp.NomColonne())
		FIN
		RENVOYER sRes
	FIN

	// Les requêtes du repository. WHERE porte toujours sur la clé primaire, par son paramètre.
	PROCEDURE EbSqlListe(oDemande est un cEbDemandeMake) : chaîne
		RENVOYER "SELECT " + EbSqlColonnes(oDemande) + " FROM " + EbSqlTable(oDemande.NomTable()) + " ORDER BY " + EbSqlNom(EbSqlCle(oDemande).NomColonne())
	FIN

	PROCEDURE EbSqlExiste(oDemande est un cEbDemandeMake) : chaîne
		oCle est un cEbChampTable = EbSqlCle(oDemande)
		RENVOYER "SELECT 1 FROM " + EbSqlTable(oDemande.NomTable()) + " WHERE " + EbSqlNom(oCle.NomColonne()) + " = " + EbSqlParametre(oCle)
	FIN

	PROCEDURE EbSqlTrouve(oDemande est un cEbDemandeMake) : chaîne
		oCle est un cEbChampTable = EbSqlCle(oDemande)
		RENVOYER "SELECT " + EbSqlColonnes(oDemande) + " FROM " + EbSqlTable(oDemande.NomTable()) + " WHERE " + EbSqlNom(oCle.NomColonne()) + " = " + EbSqlParametre(oCle)
	FIN

	// INSERT : sans la clé quand la base la donne (alors RETURNING la rend, SQLite 3.35+ et PostgreSQL), avec elle sinon.
	PROCEDURE EbSqlAjoute(oDemande est un cEbDemandeMake) : chaîne
		oCle      est un cEbChampTable = EbSqlCle(oDemande)
		sColonnes est une chaîne       = ""
		sValeurs  est une chaîne       = ""
		POUR TOUT oChamp DE oDemande.Champs()
			SI PAS (oChamp.Cle() ET EbCleGeneree(oChamp)) ALORS
				SI sColonnes <> "" ALORS
					sColonnes += ", "
					sValeurs += ", "
				FIN
				sColonnes += EbSqlNom(oChamp.NomColonne())
				sValeurs += EbSqlParametre(oChamp)
			FIN
		FIN
		sSql est une chaîne = "INSERT INTO " + EbSqlTable(oDemande.NomTable()) + " (" + sColonnes + ") VALUES (" + sValeurs + ")"
		SI EbCleGeneree(oCle) ALORS
			sSql += " RETURNING " + EbSqlNom(oCle.NomColonne())
		FIN
		RENVOYER sSql
	FIN

	// UPDATE de toutes les colonnes sauf la clé.
	PROCEDURE EbSqlModifie(oDemande est un cEbDemandeMake) : chaîne
		oCle          est un cEbChampTable = EbSqlCle(oDemande)
		sAffectations est une chaîne       = ""
		POUR TOUT oChamp DE oDemande.Champs()
			SI PAS oChamp.Cle() ALORS
				SI sAffectations <> "" ALORS
					sAffectations += ", "
				FIN
				sAffectations += EbSqlNom(oChamp.NomColonne()) + " = " + EbSqlParametre(oChamp)
			FIN
		FIN
		RENVOYER "UPDATE " + EbSqlTable(oDemande.NomTable()) + " SET " + sAffectations + " WHERE " + EbSqlNom(oCle.NomColonne()) + " = " + EbSqlParametre(oCle)
	FIN

	PROCEDURE EbSqlSupprime(oDemande est un cEbDemandeMake) : chaîne
		oCle est un cEbChampTable = EbSqlCle(oDemande)
		RENVOYER "DELETE FROM " + EbSqlTable(oDemande.NomTable()) + " WHERE " + EbSqlNom(oCle.NomColonne()) + " = " + EbSqlParametre(oCle)
	FIN
FIN
