// Commande « aide » : le menu.
EbCommandeAide est une CollectionDeProcédures

	PROCEDURE EbAfficheAide()
		Trace("ebony — framework d'applications pour OWL")
		Trace("")
		Trace("Utilisation : ebony <commande> [options]")
		Trace("")
		Trace("Commandes :")
		Trace("  aide          affiche ce message")
		Trace("  version       affiche la version d'ebony (comme ebony --version)")
		Trace("  doctor        vérifie l'environnement (--json : le rapport en JSON, pour un outil)")
		Trace("  new <nom>     crée un projet dans un nouveau dossier (le nom est libre : ebony new Café de la Gare)")
		Trace("                options : --kit api|slim, --base sqlite|postgresql|hfsql, --auth [--table utilisateurs|users], --json")
		Trace("  init          ajoute ebony au projet OWL du dossier courant, sans rien écraser (mêmes options que new, pas de nom)")
		Trace("  make resource <Nom> --champs <liste>   écrit l'entité, les repositories (SQL et mémoire), le service, les tests et le contrôleur (cinq routes REST) d'une table dans le projet courant, sans rien écraser")
		Trace("  make migration <Nom> --champs <liste>  écrit la migration qui crée une table (Nom = Cree<Table>, ou --table <table>)")
		Trace("                options : --table <table>, --dry-run (dit ce qui serait créé, n'écrit rien), --json")
		Trace("                champs  : nom:type[*][?][@table[.colonne]], séparés par des virgules ; types : " + Remplace(EbTypesChamp(), "|", ", "))
		Trace("                          * clé primaire (entier : générée par la base), ? accepte NULL, @ clé étrangère. Exemple : id:entier*,nom:texte,email:texte?")
		Trace("  migrate       applique les migrations en attente de database/migrations (--dry-run : dit lesquelles, sans rien envoyer ; --json : pour un outil)")
		Trace("                ebony migrate status : liste les migrations et leur état ; ebony migrate rollback [--pas N] : défait la dernière (ou les N dernières)")
		Trace("  token         gère les jetons d'accès de l'application (table eb_jetons) : ebony token create <nom> [--expire AAAA-MM-JJ] crée un jeton et l'affiche UNE fois (la base n'en garde que l'empreinte)")
		Trace("                ebony token list : liste les jetons (jamais leur secret) ; ebony token revoke <identifiant> : en révoque un ; --json : pour un outil")
		Trace("  request       envoie une requête HTTP à un service en cours d'exécution : ebony request GET /clients/42 [--header Nom:valeur] [--body texte] [--port N | --url adresse] [--json]")
		Trace("  env           examine la configuration du projet courant (config/env.json, .env, .env.secrets) sans le démarrer (--json : pour un outil ; jamais la valeur d'un secret)")
		Trace("  install       installe ebony pour l'utilisateur et l'ajoute au PATH")
		Trace("  uninstall     désinstalle ebony : le retire du PATH et supprime ses fichiers")
		Trace("  restore       restaure le dossier ebony/ du projet courant (après un git clone)")
		Trace("  upgrade       aligne ebony/ et ebony.conf sur la version d'ebony installée")
		Trace("")
		Trace("Codes de sortie : 0 réussite, 1 échec, 2 usage incorrect, 70 erreur interne.")
		Trace("")
		Trace("Installation : " + LigneCommande("affiche", LigneCommande("racine", "(inconnue)")))
		Trace("OWL          : " + LigneCommande("owl", "(inconnue)"))
	FIN
FIN
