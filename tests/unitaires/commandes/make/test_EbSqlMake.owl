// Tests de EbSqlMake : le CREATE TABLE par dialecte et les cinq requêtes du repository. Le texte exact est un contrat : il est écrit tel quel dans le code généré.

// La demande lue dans des arguments écrits avec des « ; ».
PROCEDURE EbTestDemandeSql(sListe est une chaîne) : cEbDemandeMake
	tabArgs est un tableau de chaînes
	nDebut  est un entier             = 1
	nFin    est un entier             = Position(sListe, ";")
	TANTQUE nFin > 0
		TableauAjoute(tabArgs, Milieu(sListe, nDebut, nFin - nDebut))
		nDebut = nFin + 1
		nFin   = Position(sListe, ";", nDebut)
	FIN
	TableauAjoute(tabArgs, Milieu(sListe, nDebut))
	oDemande est un cEbDemandeMake = EbAnalyseArgumentsMake(tabArgs)
	RENVOYER oDemande
FIN

// Les types, la clé générée, NOT NULL et la clé étrangère pour SQLite.
PROCEDURE scenario_creation_de_table_sqlite()
	oDemande est un cEbDemandeMake = EbTestDemandeSql("migration;CreeClients;--champs;id:entier*,nom:texte,email:texte?,note:reel,actif:booleen,vu:dateheure?,pays_id:entier@pays")
	dbgVérifieEgalité(EbSqlCreeTableLigne(oDemande, "sqlite"), `CREATE TABLE "clients" ( "id" INTEGER PRIMARY KEY AUTOINCREMENT, "nom" TEXT NOT NULL, "email" TEXT, "note" REAL NOT NULL, "actif" INTEGER NOT NULL, "vu" TEXT, "pays_id" INTEGER NOT NULL REFERENCES "pays" ("id") )`, "SQLite")
FIN

// PostgreSQL : identité générée, DOUBLE PRECISION, BOOLEAN.
PROCEDURE scenario_creation_de_table_postgresql()
	oDemande est un cEbDemandeMake = EbTestDemandeSql("migration;CreeClients;--champs;id:entier*,nom:texte,note:reel,actif:booleen")
	dbgVérifieEgalité(EbSqlCreeTableLigne(oDemande, "postgresql"), `CREATE TABLE "clients" ( "id" INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "nom" TEXT NOT NULL, "note" DOUBLE PRECISION NOT NULL, "actif" BOOLEAN NOT NULL )`, "PostgreSQL")
FIN

// Une clé texte est fournie par l'appelant : pas d'auto-incrément. Le schéma est gardé, chaque partie entre guillemets.
PROCEDURE scenario_cle_texte_et_schema()
	oDemande est un cEbDemandeMake = EbTestDemandeSql("migration;Initiale;--table;crm.pays;--champs;code:texte*,nom:texte")
	dbgVérifieEgalité(EbSqlCreeTableLigne(oDemande, "sqlite"), `CREATE TABLE "crm"."pays" ( "code" TEXT NOT NULL PRIMARY KEY, "nom" TEXT NOT NULL )`, "clé texte")
	dbgVérifieEgalité(EbSqlSupprimeTable(oDemande), `DROP TABLE "crm"."pays"`, "suppression")
FIN

// Les noms qui sont des mots du SQL ou qui ont des espaces ou des accents sont protégés par les guillemets doubles.
PROCEDURE scenario_noms_proteges_par_des_guillemets()
	oDemande est un cEbDemandeMake = EbTestDemandeSql("resource;Commande;--table;order;--champs;id:entier*,Date de naissance:date,user:texte,Prénom:texte")
	dbgVérifieEgalité(EbSqlListe(oDemande), `SELECT "id", "Date de naissance", "user", "Prénom" FROM "order" ORDER BY "id"`, "SELECT")
FIN

// Les cinq requêtes d'une ressource à clé générée : l'INSERT omet la clé et la rend (RETURNING), l'UPDATE ne touche pas à la clé.
PROCEDURE scenario_requetes_du_depot_cle_generee()
	oDemande est un cEbDemandeMake = EbTestDemandeSql("resource;Client;--champs;id:entier*,nom:texte,email:texte?")
	dbgVérifieEgalité(EbSqlListe(oDemande), `SELECT "id", "nom", "email" FROM "clients" ORDER BY "id"`, "liste")
	dbgVérifieEgalité(EbSqlExiste(oDemande), `SELECT 1 FROM "clients" WHERE "id" = {p_id}`, "existe")
	dbgVérifieEgalité(EbSqlTrouve(oDemande), `SELECT "id", "nom", "email" FROM "clients" WHERE "id" = {p_id}`, "trouve")
	dbgVérifieEgalité(EbSqlAjoute(oDemande), `INSERT INTO "clients" ("nom", "email") VALUES ({p_nom}, {p_email}) RETURNING "id"`, "ajoute")
	dbgVérifieEgalité(EbSqlModifie(oDemande), `UPDATE "clients" SET "nom" = {p_nom}, "email" = {p_email} WHERE "id" = {p_id}`, "modifie")
	dbgVérifieEgalité(EbSqlSupprime(oDemande), `DELETE FROM "clients" WHERE "id" = {p_id}`, "supprime")
FIN

// Avec une clé texte, l'INSERT écrit la clé et n'a pas de RETURNING.
PROCEDURE scenario_requete_d_ajout_cle_texte()
	oDemande est un cEbDemandeMake = EbTestDemandeSql("resource;Pays;--champs;code:texte*,nom:texte")
	dbgVérifieEgalité(EbSqlAjoute(oDemande), `INSERT INTO "pays" ("code", "nom") VALUES ({p_code}, {p_nom})`, "ajoute")
FIN

// Aucune valeur n'est écrite dans le texte SQL : seulement des paramètres {p_…}.
PROCEDURE scenario_aucune_valeur_dans_le_sql()
	oDemande est un cEbDemandeMake = EbTestDemandeSql("resource;Client;--champs;id:entier*,nom:texte")
	dbgVérifieVrai(Position(EbSqlAjoute(oDemande), "{p_nom}") > 0, "la valeur passe par un paramètre")
	dbgVérifieEgalité(Position(EbSqlModifie(oDemande), "'"), 0, "aucune apostrophe : pas de valeur littérale")
FIN

// Une clé étrangère vers une table d'un schéma : PostgreSQL garde le schéma, SQLite le retire (REFERENCES "crm"."pays" y est une erreur de syntaxe, mesuré).
PROCEDURE scenario_cle_etrangere_avec_schema()
	oDemande est un cEbDemandeMake = EbTestDemandeSql("migration;CreeClients;--champs;id:entier*,pays_id:entier@crm.pays.id")
	dbgVérifieVrai(Position(EbSqlCreeTableLigne(oDemande, "postgresql"), `REFERENCES "crm"."pays" ("id")`) > 0, "PostgreSQL : schéma gardé")
	dbgVérifieVrai(Position(EbSqlCreeTableLigne(oDemande, "sqlite"), `REFERENCES "pays" ("id")`) > 0, "SQLite : schéma retiré")
	dbgVérifieEgalité(EbSchemaTable("crm.pays"), "crm", "schéma")
	dbgVérifieEgalité(EbSchemaTable("pays"), "", "pas de schéma")
FIN
